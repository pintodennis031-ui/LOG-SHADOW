            Btn.TextSize = 11
            Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 6)
            Btn.MouseButton1Click:Connect(function() if cb then task.spawn(cb) end end)
        end

        CreateSmallBtn(text1, color1, cb1, 0.38)
        CreateSmallBtn(text2, color2, cb2, 0.38 + w + gap)
        CreateSmallBtn(text3, color3, cb3, 0.38 + (w*2) + (gap*2))
    end

