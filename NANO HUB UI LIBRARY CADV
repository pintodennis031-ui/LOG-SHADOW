    function TabObject:CreateDropdown(text, refreshFunc, selectFunc)
        local Frame = Instance.new("Frame", PageScroll)
        Frame.LayoutOrder = self:NextOrder()
        Frame.Size = UDim2.new(1, -5, 0, 32)
        Frame.BackgroundColor3 = Theme.Secondary
        Frame.ZIndex = 1
        Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 6)

        local MainBtn = Instance.new("TextButton", Frame)
        MainBtn.Size = UDim2.new(1, 0, 1, 0)
        MainBtn.BackgroundTransparency = 1
        MainBtn.Text = "  " .. text
        MainBtn.TextColor3 = Theme.TextHighlight
        MainBtn.Font = Enum.Font.GothamMedium
        MainBtn.TextSize = 12
        MainBtn.TextXAlignment = Enum.TextXAlignment.Left

        local DropScroll = Instance.new("ScrollingFrame", Frame)
        DropScroll.Size = UDim2.new(1, 0, 0, 120)
        DropScroll.Position = UDim2.new(0, 0, 1, 2)
        DropScroll.BackgroundColor3 = Theme.PanelLight
        DropScroll.Visible = false
        DropScroll.ScrollBarThickness = 3
        DropScroll.ZIndex = 50 
        Instance.new("UICorner", DropScroll).CornerRadius = UDim.new(0, 6)
        local DLayout = Instance.new("UIListLayout", DropScroll)

        MainBtn.MouseButton1Click:Connect(function()
            DropScroll.Visible = not DropScroll.Visible
            if DropScroll.Visible then
                Frame.ZIndex = 5 
                for _, v in pairs(DropScroll:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end
                local options = refreshFunc()
                DropScroll.CanvasSize = UDim2.new(0, 0, 0, #options * 25)
                for _, opt in ipairs(options) do
                    local btn = Instance.new("TextButton", DropScroll)
                    btn.Size = UDim2.new(1, 0, 0, 25)
                    btn.BackgroundTransparency = 1
                    btn.Text = "  " .. opt.Name
                    btn.TextColor3 = Theme.Text
                    btn.Font = Enum.Font.Gotham
                    btn.TextSize = 11
                    btn.TextXAlignment = Enum.TextXAlignment.Left
                    btn.ZIndex = 51
                    btn.MouseButton1Click:Connect(function()
                        MainBtn.Text = "  " .. text .. ": " .. opt.Name
                        DropScroll.Visible = false
                        Frame.ZIndex = 1
                        selectFunc(opt.Data)
                    end)
                end
            else
                Frame.ZIndex = 1
            end
        end)
        return MainBtn
    end

