local NanoHub = {}
NanoHub.__index = NanoHub

local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer
local TargetGui = pcall(function() return CoreGui.Name end) and CoreGui or LocalPlayer:WaitForChild("PlayerGui")

-- Exportamos variables clave para que el script principal pueda usarlas
NanoHub.TargetGui = TargetGui
NanoHub.Theme = {
    Primary = Color3.fromRGB(110, 65, 160),      
    PrimaryDark = Color3.fromRGB(80, 45, 120),   
    Secondary = Color3.fromRGB(50, 50, 60),      
    Background = Color3.fromRGB(15, 15, 20),     
    Panel = Color3.fromRGB(20, 20, 25),          
    PanelLight = Color3.fromRGB(30, 30, 40),     
    Text = Color3.fromRGB(200, 200, 200),        
    TextHighlight = Color3.fromRGB(255, 255, 255),
    Danger = Color3.fromRGB(140, 40, 40),        
    Success = Color3.fromRGB(40, 140, 80)        
}

local Theme = NanoHub.Theme

function NanoHub.new(titleText)
    local self = setmetatable({}, NanoHub)
    if TargetGui:FindFirstChild("NanoHub_UI") then TargetGui.NanoHub_UI:Destroy() end

    self.ScreenGui = Instance.new("ScreenGui", TargetGui)
    self.ScreenGui.Name = "NanoHub_UI"
    self.ScreenGui.ResetOnSpawn = false
    self.ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

    self.MainFrame = Instance.new("Frame", self.ScreenGui)
    self.MainFrame.Size = UDim2.new(0, 520, 0, 360)
    self.MainFrame.Position = UDim2.new(0.5, -260, 0.5, -180)
    self.MainFrame.BackgroundColor3 = Theme.Background
    self.MainFrame.Active = true
    self.MainFrame.Draggable = true
    Instance.new("UICorner", self.MainFrame).CornerRadius = UDim.new(0, 8)
    Instance.new("UIStroke", self.MainFrame).Color = Theme.Secondary

    local TopBar = Instance.new("Frame", self.MainFrame)
    TopBar.Size = UDim2.new(1, 0, 0, 35)
    TopBar.BackgroundTransparency = 1
    
    local Title = Instance.new("TextLabel", TopBar)
    Title.Size = UDim2.new(1, -40, 1, 0)
    Title.Position = UDim2.new(0, 15, 0, 0)
    Title.BackgroundTransparency = 1
    Title.Text = titleText
    Title.TextColor3 = Theme.TextHighlight
    Title.Font = Enum.Font.GothamBlack
    Title.TextSize = 14
    Title.TextXAlignment = Enum.TextXAlignment.Left

    local CloseBtn = Instance.new("TextButton", TopBar)
    CloseBtn.Size = UDim2.new(0, 24, 0, 24)
    CloseBtn.Position = UDim2.new(1, -30, 0, 5)
    CloseBtn.BackgroundColor3 = Theme.Danger
    CloseBtn.Text = "X"
    CloseBtn.TextColor3 = Theme.TextHighlight
    CloseBtn.Font = Enum.Font.GothamBold
    Instance.new("UICorner", CloseBtn).CornerRadius = UDim.new(0, 4)
    CloseBtn.MouseButton1Click:Connect(function() self:Destroy() end)

    self.TabContainer = Instance.new("ScrollingFrame", self.MainFrame)
    self.TabContainer.Size = UDim2.new(0, 130, 1, -35)
    self.TabContainer.Position = UDim2.new(0, 0, 0, 35)
    self.TabContainer.BackgroundColor3 = Theme.Panel
    self.TabContainer.ScrollBarThickness = 2
    self.TabContainer.AutomaticCanvasSize = Enum.AutomaticSize.Y
    Instance.new("UICorner", self.TabContainer).CornerRadius = UDim.new(0, 8)
    local TabLayout = Instance.new("UIListLayout", self.TabContainer)
    TabLayout.Padding = UDim.new(0, 2)

    self.ContentContainer = Instance.new("Frame", self.MainFrame)
    self.ContentContainer.Size = UDim2.new(1, -140, 1, -45)
    self.ContentContainer.Position = UDim2.new(0, 135, 0, 40)
    self.ContentContainer.BackgroundTransparency = 1

    self.Tabs = {}
    self.Pages = {}
    self.Connections = {}
    
    local inputConn = UserInputService.InputBegan:Connect(function(input, gpe)
        if not gpe and input.KeyCode == Enum.KeyCode.LeftControl then
            self.MainFrame.Visible = not self.MainFrame.Visible
        end
    end)
    table.insert(self.Connections, inputConn)

    return self
end

function NanoHub:Destroy()
    if self.OnClose then task.spawn(self.OnClose) end
    for _, conn in ipairs(self.Connections) do
        if conn.Connected then conn:Disconnect() end
    end
    if self.ScreenGui then self.ScreenGui:Destroy() end
end

function NanoHub:CreateTab(tabName)
    local hubInstance = self
    local TabBtn = Instance.new("TextButton", self.TabContainer)
    TabBtn.Size = UDim2.new(1, 0, 0, 35)
    TabBtn.BackgroundColor3 = Theme.Panel
    TabBtn.Text = "  " .. tabName
    TabBtn.TextColor3 = Theme.Text
    TabBtn.Font = Enum.Font.GothamBold
    TabBtn.TextSize = 12
    TabBtn.TextXAlignment = Enum.TextXAlignment.Left

    local PageScroll = Instance.new("ScrollingFrame", self.ContentContainer)
    PageScroll.Size = UDim2.new(1, 0, 1, 0)
    PageScroll.BackgroundTransparency = 1
    PageScroll.ScrollBarThickness = 3
    PageScroll.Visible = false
    PageScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    
    local PageLayout = Instance.new("UIListLayout", PageScroll)
    PageLayout.Padding = UDim.new(0, 6)
    PageLayout.SortOrder = Enum.SortOrder.LayoutOrder

    TabBtn.MouseButton1Click:Connect(function()
        for _, page in pairs(self.Pages) do page.Visible = false end
        for _, btn in pairs(self.Tabs) do 
            btn.BackgroundColor3 = Theme.Panel
            btn.TextColor3 = Theme.Text
        end
        PageScroll.Visible = true
        TabBtn.BackgroundColor3 = Theme.Primary
        TabBtn.TextColor3 = Theme.TextHighlight
    end)

    table.insert(self.Tabs, TabBtn)
    table.insert(self.Pages, PageScroll)

    if #self.Tabs == 1 then
        PageScroll.Visible = true
        TabBtn.BackgroundColor3 = Theme.Primary
        TabBtn.TextColor3 = Theme.TextHighlight
    end

    local TabObject = { LayoutIndex = 0, Page = PageScroll }
    
    function TabObject:NextOrder()
        self.LayoutIndex = self.LayoutIndex + 1
        return self.LayoutIndex
    end
    
    function TabObject:CreateLabel(text)
        local Lbl = Instance.new("TextLabel", PageScroll)
        Lbl.LayoutOrder = self:NextOrder()
        Lbl.Size = UDim2.new(1, 0, 0, 20)
        Lbl.BackgroundTransparency = 1
        Lbl.Text = text
        Lbl.TextColor3 = Theme.Text
        Lbl.Font = Enum.Font.GothamMedium
        Lbl.TextSize = 12
        Lbl.TextXAlignment = Enum.TextXAlignment.Center
        return Lbl
    end

    function TabObject:CreateButton(text, color, callback)
        local Btn = Instance.new("TextButton", PageScroll)
        Btn.LayoutOrder = self:NextOrder()
        Btn.Size = UDim2.new(1, -5, 0, 32)
        Btn.BackgroundColor3 = color or Theme.Secondary
        Btn.Text = text
        Btn.TextColor3 = Theme.TextHighlight
        Btn.Font = Enum.Font.GothamBold
        Btn.TextSize = 12
        Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 6)
        Btn.MouseButton1Click:Connect(function() if callback then task.spawn(callback) end end)
        return Btn
    end

