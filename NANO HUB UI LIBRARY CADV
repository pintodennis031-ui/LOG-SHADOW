        local BtnContainer = Instance.new("Frame", Frame)
        BtnContainer.Size = UDim2.new(1, 0, 0, 28)
        BtnContainer.Position = UDim2.new(0, 0, 0, 18)
        BtnContainer.BackgroundColor3 = Theme.PanelLight
        Instance.new("UICorner", BtnContainer).CornerRadius = UDim.new(0, 6)

        local Layout = Instance.new("UIListLayout", BtnContainer)
        Layout.FillDirection = Enum.FillDirection.Horizontal
        Layout.SortOrder = Enum.SortOrder.LayoutOrder

        local btns = {}
        for i, opt in ipairs(options) do
            local btn = Instance.new("TextButton", BtnContainer)
            btn.Size = UDim2.new(1/#options, 0, 1, 0)
            btn.BackgroundTransparency = (i == defaultIndex) and 0 or 1
            btn.BackgroundColor3 = Theme.Primary
            btn.Text = opt
            btn.TextColor3 = (i == defaultIndex) and Theme.TextHighlight or Theme.Text
            btn.Font = Enum.Font.GothamMedium
            btn.TextSize = 11
            Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

            btn.MouseButton1Click:Connect(function()
                for j, b in ipairs(btns) do
                    b.BackgroundTransparency = 1
                    b.TextColor3 = Theme.Text
                end
                btn.BackgroundTransparency = 0
                btn.TextColor3 = Theme.TextHighlight
                callback(opt, i)
            end)
            table.insert(btns, btn)
        end
    end

    function TabObject:CreateGridToggles(title, options, configTable)
        local Frame = Instance.new("Frame", PageScroll)
        Frame.LayoutOrder = self:NextOrder()
        Frame.Size = UDim2.new(1, -5, 0, 20 + math.ceil(#options / 5) * 28)
        Frame.BackgroundTransparency = 1

        local Lbl = Instance.new("TextLabel", Frame)
        Lbl.Size = UDim2.new(1, 0, 0, 15)
        Lbl.BackgroundTransparency = 1
        Lbl.Text = title
        Lbl.TextColor3 = Theme.Text
        Lbl.Font = Enum.Font.GothamMedium
        Lbl.TextSize = 11
        Lbl.TextXAlignment = Enum.TextXAlignment.Left

        local GridContainer = Instance.new("Frame", Frame)
        GridContainer.Size = UDim2.new(1, 0, 1, -20)
        GridContainer.Position = UDim2.new(0, 0, 0, 20)
        GridContainer.BackgroundTransparency = 1

        local Grid = Instance.new("UIGridLayout", GridContainer)
        Grid.CellSize = UDim2.new(0.18, 0, 0, 24)
        Grid.CellPadding = UDim2.new(0.02, 0, 0, 4)
        Grid.SortOrder = Enum.SortOrder.LayoutOrder

        for i, opt in ipairs(options) do
            local key = opt.Key or opt.Label
            local Btn = Instance.new("TextButton", GridContainer)
            Btn.Text = opt.Label
            Btn.Font = Enum.Font.GothamBold
            Btn.TextSize = 10
            Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 4)

            local function UpdateVisual()
                local isEnabled = configTable[key]
                if isEnabled == nil and tonumber(key) then isEnabled = configTable[tonumber(key)] end
                if isEnabled == nil then isEnabled = configTable[tostring(key)] end
                
                Btn.BackgroundColor3 = isEnabled and Theme.Primary or Theme.Secondary
                Btn.TextColor3 = isEnabled and Theme.TextHighlight or Theme.Text
            end
            UpdateVisual()

            Btn.MouseButton1Click:Connect(function()
                local currentState = configTable[key]
                if currentState == nil and tonumber(key) then currentState = configTable[tonumber(key)] end
                if currentState == nil then currentState = configTable[tostring(key)] end
                
                local newState = not currentState
                
                configTable[tostring(key)] = newState
                if tonumber(key) then configTable[tonumber(key)] = newState end
                
                UpdateVisual()
            end)
        end
    end

    function TabObject:CreateLargeToggle(textOff, textOn, colorOff, colorOn, defaultState, callback)
        local state = defaultState
        local Frame = Instance.new("Frame", PageScroll)
        Frame.LayoutOrder = self:NextOrder()
        Frame.Size = UDim2.new(1, -5, 0, 40)
        Frame.BackgroundTransparency = 1

        local Btn = Instance.new("TextButton", Frame)
        Btn.Size = UDim2.new(1, 0, 1, 0)
        Btn.BackgroundColor3 = state and colorOn or colorOff
        Btn.Text = state and textOn or textOff
        Btn.TextColor3 = Theme.TextHighlight
        Btn.Font = Enum.Font.GothamBlack
        Btn.TextSize = 14
        Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 6)

        Btn.MouseButton1Click:Connect(function()
            state = not state
            Btn.Text = state and textOn or textOff
            TweenService:Create(Btn, TweenInfo.new(0.2), {BackgroundColor3 = state and colorOn or colorOff}):Play()
            if callback then task.spawn(function() callback(state) end) end
        end)
        
        return {
            SetState = function(newState, customText)
                state = newState
                Btn.Text = customText or (state and textOn or textOff)
                Btn.BackgroundColor3 = state and colorOn or colorOff
            end
        }
    end

    function TabObject:CreateTextBox(title, defaultText, callback)
        local Frame = Instance.new("Frame", PageScroll)
        Frame.LayoutOrder = self:NextOrder()
        Frame.Size = UDim2.new(1, -5, 0, 50)
        Frame.BackgroundTransparency = 1

        local Lbl = Instance.new("TextLabel", Frame)
        Lbl.Size = UDim2.new(1, 0, 0, 15)
        Lbl.BackgroundTransparency = 1
        Lbl.Text = title
        Lbl.TextColor3 = Theme.Text
        Lbl.Font = Enum.Font.GothamMedium
        Lbl.TextSize = 11
        Lbl.TextXAlignment = Enum.TextXAlignment.Left

        local Box = Instance.new("TextBox", Frame)
        Box.Size = UDim2.new(1, 0, 0, 30)
        Box.Position = UDim2.new(0, 0, 0, 20)
        Box.BackgroundColor3 = Theme.PanelLight
        Box.TextColor3 = Theme.TextHighlight
        Box.Font = Enum.Font.Code
        Box.TextSize = 11
        Box.Text = defaultText
        Box.ClearTextOnFocus = false
        Box.TextXAlignment = Enum.TextXAlignment.Left
        Instance.new("UICorner", Box).CornerRadius = UDim.new(0, 4)
        Instance.new("UIStroke", Box).Color = Theme.Secondary

        Box.FocusLost:Connect(function() callback(Box.Text) end)
    end

    return TabObject
end

return NanoHub
